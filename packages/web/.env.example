# Firebase(Authentication + Firestore)によるパレット/設定/プロジェクト同期に使う設定値
# (Firebaseコンソール→プロジェクトの設定→マイアプリ→ウェブアプリのfirebaseConfigからコピー)。
# 実際の値は .env に書く(.gitignore対象、コミットされない)。GitHub Pagesへのデプロイでは、
# .github/workflows/deploy-pages.yml がリポジトリのSecretsから同名の環境変数を注入してビルドする。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
