{
  "name": "mini-rough-app",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=packages/web",
    "dev:electron": "wait-on tcp:5173 && npm run start --workspace=packages/electron-shell",
    "dev": "concurrently \"npm:dev:web\" \"npm:dev:electron\""
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "wait-on": "^8.0.0",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  }
}
